{
  "name": "@mcp-z/client",
  "version": "2.2.5",
  "description": "Programmatic MCP client library for Node.js - connect, discover, and call tools on Model Context Protocol servers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "server",
    "client",
    "lib",
    "token-storage",
    "testing",
    "integration-testing",
    "development-tools",
    "server-management",
    "lifecycle",
    "graceful-shutdown",
    "test-utilities",
    "workflow",
    "ai",
    "claude"
  ],
  "homepage": "https://github.com/mcp-z/cli#readme",
  "bugs": {
    "url": "https://github.com/mcp-z/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-z/cli.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff.info@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsds validate",
    "format": "tsds format",
    "generate:types": "json2ts schemas/servers.schema.json schemas/servers.d.ts --bannerComment \"/* eslint-disable */\n/* Auto-generated from schemas/servers.schema.json - DO NOT EDIT */\"",
    "prepublish:check": "ncp",
    "prepublishOnly": "node scripts/require-dist-tag.cjs && tsds validate",
    "test": "tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:ci": "tsds test:node --require test/lib/env-loader.ts --no-timeouts --ignore \"test/integration/auth/todoist-oauth.test.ts\"",
    "test:ci:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts --ignore \"test/integration/auth/todoist-oauth.test.ts\"",
    "test:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "cross-spawn": "^7.0.6",
    "get-port": "5.1.1",
    "ipaddr.js": "^2.5.0",
    "keyv": "^5.0.0",
    "keyv-file": "5.3.3",
    "module-root-sync": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "express": "^5.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "node-version-use": "^2.4.7",
    "ts-dev-stack": "^1.22.1",
    "tsds-config": "^1.0.4",
    "tsds-lib": "^1.22.6",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "tsds": {
    "source": "src/index.ts"
  }
}
